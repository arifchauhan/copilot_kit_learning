# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build
dist/

# misc
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# turbo / caches
.turbo

# editors (local)
.idea/

# LangGraph dev server state (root and agent/)
.langgraph_api/

# Added by CopilotKit CLI: browser snapshots a coding agent writes.
.playwright-mcp/

# CopilotKit local state — commit only .copilotkit/project.json (Intelligence project binding)
.copilotkit/*
!.copilotkit/project.json

# CopilotKit agent skills: commit skills-lock.json + .agents/skills/ (or reinstall via
# `npx copilotkit@latest skills install`). Ignore IDE-specific duplicate copies.
.claude/skills/
