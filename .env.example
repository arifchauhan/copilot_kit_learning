# Model (required for LangGraph agent)
OPENAI_API_KEY=

# LangGraph dev server (default matches scripts/run-agent.mjs)
AGENT_URL=http://127.0.0.1:8123

# Optional: CopilotKit Intelligence (threads, gateway)
CPK_INTELLIGENCE_API_KEY=
# INTELLIGENCE_API_URL=
# INTELLIGENCE_GATEWAY_WS_URL=

# Optional: override agent model (e.g. anthropic:claude-sonnet-4-5)
# COPILOTKIT_AGENT_MODEL=

# Optional: MCP app server for runtime (omit to disable MCP discovery)
# MCP_SERVER_URL=

# Optional: LangSmith
# LANGSMITH_API_KEY=
